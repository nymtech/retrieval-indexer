{
  "name": "@nymproject/retrieval-indexer",
  "version": "0.2.0",
  "description": "Chunks, embeds, and indexes docs and source code into a Postgres + pgvector retrieval store",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nymtech/retrieval-indexer.git"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./chunker": {
      "types": "./dist/chunker.d.ts",
      "default": "./dist/chunker.js"
    },
    "./code-chunker": {
      "types": "./dist/code-chunker.d.ts",
      "default": "./dist/code-chunker.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "default": "./dist/embed.js"
    },
    "./items": {
      "types": "./dist/items.d.ts",
      "default": "./dist/items.js"
    },
    "./mdx": {
      "types": "./dist/mdx.d.ts",
      "default": "./dist/mdx.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "default": "./dist/search.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./walk": {
      "types": "./dist/walk.d.ts",
      "default": "./dist/walk.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "pg": "^8.23.1",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "author": "Nym Technologies SA",
  "engines": {
    "node": ">=20"
  }
}
